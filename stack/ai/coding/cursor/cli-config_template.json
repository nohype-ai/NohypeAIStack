{
  "permissions": {
    "allow": ["Shell(*)", "Read(**)", "Write(**)", "WebFetch(*)", "Mcp(*:*)"],
    "deny": []
  },
  "version": 1,
  "editor": {
    "vimMode": false
  },
  "hasChangedDefaultModel": true,
  "maxMode": false,
  "network": {
    "useHttp1ForAgent": true
  },
  "approvalMode": "allowlist",
  "sandbox": {
    "mode": "disabled",
    "networkAccess": "user_config_with_defaults"
  },
  "attribution": {
    "attributeCommitsToAgent": false,
    "attributePRsToAgent": false
  }
}
